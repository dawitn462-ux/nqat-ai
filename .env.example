# Target Environment Configuration (HTTPS Secured)
TARGET_URL=https://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# HTTPS & Security Hardening
ENFORCE_HTTPS=true
HTTPS_PORT=8443
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# Scanner Core Configuration
LOG_LEVEL=INFO
MAX_CONCURRENCY=5
SCAN_TIMEOUT=30
REQUEST_RETRIES=3

# Rate Limiting & Scope Enforcement
MAX_REQUESTS_PER_SECOND=10
STRICT_SCOPE_ENFORCEMENT=true

# Dashboard & Web Application Settings (HTTPS)
PORT=8443
HOST=127.0.0.1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/nkat_ai

# Finding Review Deadlines (Minutes)
DEADLINE_CRITICAL_MINUTES=2
DEADLINE_HIGH_MINUTES=5
DEADLINE_MEDIUM_MINUTES=10
DEADLINE_LOW_MINUTES=20
DEADLINE_INFO_MINUTES=20

# API Security Hardening
API_KEY=nkat_secret_api_key_2026

# Gmail SMTP Verification Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=NKAT AI Platform <your_email@gmail.com>

# Google OAuth 2.0 Identity Services Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# LOCAL-FIRST SECURITY & DATA ISOLATION NOTICE
# This database, its schema (organizations, users, scans, findings), credentials, and audit logs
# remain strictly on localhost. No table, field, or user data here is EVER transmitted externally,
# except existing NVD CVE REST client lookups which fetch public vulnerability reference data only.
LOCAL_ONLY_STRICT=true





